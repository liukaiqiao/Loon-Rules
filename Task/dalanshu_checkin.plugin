#!name=大蓝树自动签到 (自建修复版)
#!desc=大蓝树每日自动签到，包含获取Token与定时任务。
#!author=liukaiqiao
#!icon=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/dalanshu.png

[Script]
# 1. 获取 Token (已移除会导致卡死的 requires-body=true)
http-request ^https?:\/\/dalanshu\.top\/api\/v1\/me\/checkin\/status script-path=https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/cookie/get_cookie.js, timeout=20, tag=大蓝树每日签到Token

# 2. 定时签到 (已确保路径包含 /Task/ 文件夹，每天早上 7:05 执行，错开高峰期)
cron "05 7 * * *" script-path=https://raw.githubusercontent.com/liukaiqiao/Loon-Rules/refs/heads/main/Task/dalanshu_checkin.js, timeout=60, tag=大蓝树每日签到

[Mitm]
hostname = dalanshu.top

