[Script]
# 1. 获取 Token (调用你自己的专属抓取脚本)
http-request ^https?:\/\/dalanshu\.top\/api\/v1\/me\/checkin\/status script-path=https://raw.githubusercontent.com/liukaiqiao/Loon-Rules/refs/heads/main/Task/dalanshu_cookie.js, requires-body=false, timeout=20, tag=大蓝树获取Token

# 2. 定时签到
cron "30 8 * * *" script-path=https://raw.githubusercontent.com/liukaiqiao/Loon-Rules/refs/heads/main/Task/dalanshu.js, timeout=60, tag=大蓝树每日签到

[Mitm]
hostname = dalanshu.top
