#!name=一点万象自动签到 (自建版)
#!desc=一点万象每日自动签到，包含获取Token与定时任务。
#!author=liukaiqiao
#!icon=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/airport/airport.png

[Script]
# 1. 获取 Token
http-request ^https?:\/\/.*\.mixcapp\.com script-path=https://raw.githubusercontent.com/liukaiqiao/Loon-Rules/refs/heads/main/Task/mixc_signin.js, requires-body=true, timeout=20, tag=一点万象获取Token

# 2. 定时签到 (每天早上 7:00 执行)
cron "00 7 * * *" script-path=https://raw.githubusercontent.com/liukaiqiao/Loon-Rules/refs/heads/main/Task/mixc_signin.js, timeout=60, tag=一点万象每日签到

[Mitm]
hostname = *.mixcapp.com
