[ini]
#!name=彩云天气 SVIP (自建终极版)
#!desc=解锁彩云天气 SVIP 权限。底层脚本归属 wf021325。
#!author=liukaiqiao
#!icon=https://gitlab.com/lodepuly/iconlibrary/-/raw/main/App_icon/120px/ColorfulCloudsPro.png

[Script]
# 匹配 wf021325 作者专属的拦截规则
http-response ^https?:\/\/biz\.(caiyunapp|cyapi)\.(com|cn)\/(v\d\/user|ops\/v\d\/app_limit\/ad_vip) script-path=https://raw.githubusercontent.com/liukaiqiao/Loon-Rules/refs/heads/main/Plugins/caiyuntianqi.js, requires-body=true, timeout=20, tag=彩云天气SVIP

[Mitm]
hostname = biz.caiyunapp.com, biz.cyapi.cn
